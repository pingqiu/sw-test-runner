{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "seaweed.inventory/v1"
    },
    "state": {
      "type": "string",
      "enum": [
        "requested",
        "resolved"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "target": {
      "type": "string",
      "enum": [
        "azure",
        "aws",
        "gcp",
        "onprem",
        "docker"
      ]
    },
    "transport": {
      "type": "string",
      "enum": [
        "http",
        "rc",
        "dc"
      ]
    },
    "artifact_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "managed_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_./:@+=-]{1,2048}$"
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/host"
      },
      "minItems": 1,
      "maxItems": 128
    },
    "observation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/observation"
        }
      ]
    },
    "deadlines": {
      "$ref": "#/$defs/deadlines"
    },
    "docker": {
      "$ref": "#/$defs/docker_profile"
    }
  },
  "required": [
    "schema",
    "state",
    "run_id",
    "target",
    "transport",
    "artifact_manifest_sha256",
    "managed_resource_ids",
    "hosts",
    "deadlines"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "const": "onprem"
          }
        }
      },
      "then": {
        "properties": {
          "managed_resource_ids": {
            "maxItems": 0
          },
          "hosts": {
            "items": {
              "properties": {
                "resource_id": {
                  "const": ""
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "managed_resource_ids": {
            "minItems": 1
          },
          "hosts": {
            "items": {
              "properties": {
                "resource_id": {
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "requested"
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "observation": {
            "$ref": "#/$defs/observation"
          },
          "hosts": {
            "items": {
              "properties": {
                "management": {
                  "properties": {
                    "host_key": {
                      "minLength": 1
                    }
                  }
                },
                "data": {
                  "properties": {
                    "nic": {
                      "minLength": 1
                    },
                    "mtu": {
                      "type": "integer",
                      "minimum": 576,
                      "maximum": 65535
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "observation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "http"
          },
          "state": {
            "const": "requested"
          }
        }
      },
      "then": {
        "properties": {
          "hosts": {
            "items": {
              "properties": {
                "rdma": {
                  "$ref": "#/$defs/rdma_na"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "http"
          },
          "state": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "properties": {
          "hosts": {
            "items": {
              "properties": {
                "rdma": {
                  "$ref": "#/$defs/rdma_na"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "rc"
          },
          "state": {
            "const": "requested"
          }
        }
      },
      "then": {
        "properties": {
          "hosts": {
            "items": {
              "if": {
                "properties": {
                  "roles": {
                    "contains": {
                      "enum": [
                        "client",
                        "volume"
                      ]
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "rdma": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/rdma_requested"
                      },
                      {
                        "properties": {
                          "capabilities": {
                            "contains": {
                              "const": "rc"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "rdma": {
                    "$ref": "#/$defs/rdma_na"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "rc"
          },
          "state": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "properties": {
          "hosts": {
            "items": {
              "if": {
                "properties": {
                  "roles": {
                    "contains": {
                      "enum": [
                        "client",
                        "volume"
                      ]
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "rdma": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/rdma_observed"
                      },
                      {
                        "properties": {
                          "capabilities": {
                            "contains": {
                              "const": "rc"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "rdma": {
                    "$ref": "#/$defs/rdma_na"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "dc"
          },
          "state": {
            "const": "requested"
          }
        }
      },
      "then": {
        "properties": {
          "hosts": {
            "items": {
              "if": {
                "properties": {
                  "roles": {
                    "contains": {
                      "enum": [
                        "client",
                        "volume"
                      ]
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "rdma": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/rdma_requested"
                      },
                      {
                        "properties": {
                          "capabilities": {
                            "contains": {
                              "const": "dc"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "rdma": {
                    "$ref": "#/$defs/rdma_na"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "dc"
          },
          "state": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "properties": {
          "hosts": {
            "items": {
              "if": {
                "properties": {
                  "roles": {
                    "contains": {
                      "enum": [
                        "client",
                        "volume"
                      ]
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "rdma": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/rdma_observed"
                      },
                      {
                        "properties": {
                          "capabilities": {
                            "contains": {
                              "const": "dc"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "rdma": {
                    "$ref": "#/$defs/rdma_na"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "resolved"
          },
          "target": {
            "not": {
              "const": "docker"
            }
          }
        }
      },
      "then": {
        "properties": {
          "hosts": {
            "items": {
              "properties": {
                "disks": {
                  "items": {
                    "properties": {
                      "device_id": {
                        "minLength": 17
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "docker"
          }
        }
      },
      "then": {
        "required": [
          "docker"
        ],
        "properties": {
          "transport": {
            "enum": [
              "http",
              "rc"
            ]
          },
          "hosts": {
            "minItems": 14,
            "items": {
              "required": [
                "container"
              ],
              "properties": {
                "roles": {
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "enum": [
                      "master",
                      "filer",
                      "volume",
                      "client",
                      "metadata"
                    ]
                  }
                },
                "disks": {
                  "items": {
                    "properties": {
                      "device_id": {
                        "const": ""
                      },
                      "format_allowed": {
                        "const": false
                      }
                    }
                  }
                },
                "rdma": {
                  "properties": {
                    "capabilities": {
                      "items": {
                        "const": "rc"
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "roles": {
                        "contains": {
                          "const": "filer"
                        }
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "metadata_host_id"
                    ]
                  },
                  "else": {
                    "properties": {
                      "metadata_host_id": false
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "roles": {
                        "contains": {
                          "const": "metadata"
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "disks": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "roles": {
                      "const": [
                        "master"
                      ]
                    }
                  }
                },
                "minContains": 3,
                "maxContains": 3
              },
              {
                "contains": {
                  "properties": {
                    "roles": {
                      "const": [
                        "filer"
                      ]
                    }
                  }
                },
                "minContains": 2,
                "maxContains": 2
              },
              {
                "contains": {
                  "properties": {
                    "roles": {
                      "const": [
                        "volume"
                      ]
                    }
                  }
                },
                "minContains": 4
              },
              {
                "contains": {
                  "properties": {
                    "roles": {
                      "const": [
                        "client"
                      ]
                    }
                  }
                },
                "minContains": 4
              },
              {
                "contains": {
                  "properties": {
                    "roles": {
                      "const": [
                        "metadata"
                      ]
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "transport": {
                  "const": "http"
                }
              }
            },
            "then": {
              "properties": {
                "docker": {
                  "properties": {
                    "rdma_mode": {
                      "const": "none"
                    },
                    "unavailable_transports": {
                      "items": {
                        "properties": {
                          "reason": {
                            "const": "software_profile_no_dc"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "docker": {
                  "properties": {
                    "rdma_mode": {
                      "const": "rxe"
                    },
                    "unavailable_transports": {
                      "items": {
                        "properties": {
                          "reason": {
                            "const": "rxe_no_dc"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "resolved"
                }
              }
            },
            "then": {
              "properties": {
                "docker": {
                  "properties": {
                    "parent": {
                      "properties": {
                        "boot_id": {
                          "minLength": 36
                        },
                        "root_device": {
                          "minLength": 1
                        },
                        "root_inode": {
                          "minLength": 1
                        }
                      }
                    },
                    "network": {
                      "properties": {
                        "id": {
                          "minLength": 64
                        }
                      }
                    }
                  }
                },
                "hosts": {
                  "items": {
                    "properties": {
                      "container": {
                        "properties": {
                          "id": {
                            "minLength": 64
                          },
                          "netns_inode": {
                            "minLength": 1
                          },
                          "mounts": {
                            "items": {
                              "properties": {
                                "source_device": {
                                  "minLength": 1
                                },
                                "source_inode": {
                                  "minLength": 1
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "docker": false,
          "hosts": {
            "items": {
              "properties": {
                "container": false,
                "metadata_host_id": false,
                "roles": {
                  "items": {
                    "enum": [
                      "master",
                      "filer",
                      "volume",
                      "s3",
                      "client"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seaweed:inventory:v1",
  "title": "Seaweed inventory v1: data, never authorization",
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string",
          "maxLength": 2048
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "master",
              "filer",
              "volume",
              "s3",
              "client",
              "metadata"
            ]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "management": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "ipv4"
                },
                {
                  "type": "string",
                  "format": "ipv6"
                },
                {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$"
                }
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "user": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
            },
            "credential_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "host_key": {
              "type": "string",
              "pattern": "^(?:|[A-Za-z0-9@._+-]+ [A-Za-z0-9+/]+={0,2})$"
            }
          },
          "required": [
            "address",
            "port",
            "user",
            "credential_ref",
            "host_key"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "ipv4"
                },
                {
                  "type": "string",
                  "format": "ipv6"
                }
              ]
            },
            "nic": {
              "type": "string",
              "pattern": "^(?:|[A-Za-z0-9_.:-]{1,64})$"
            },
            "mtu": {
              "anyOf": [
                {
                  "const": 0
                },
                {
                  "type": "integer",
                  "minimum": 576,
                  "maximum": 65535
                }
              ]
            }
          },
          "required": [
            "address",
            "nic",
            "mtu"
          ]
        },
        "run_root": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_./-]+$"
        },
        "disks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/disk"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "rdma": {
          "anyOf": [
            {
              "$ref": "#/$defs/rdma_na"
            },
            {
              "$ref": "#/$defs/rdma_requested"
            },
            {
              "$ref": "#/$defs/rdma_observed"
            }
          ]
        },
        "services": {
          "type": "array",
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "port"
            ],
            "properties": {
              "name": {
                "enum": [
                  "master_http",
                  "master_grpc",
                  "filer_http",
                  "filer_grpc",
                  "volume_http",
                  "volume_grpc",
                  "s3_http",
                  "rdma",
                  "rdma_push",
                  "kv_coordinator",
                  "rdma_control",
                  "dc_control"
                ]
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "container": {
          "$ref": "#/$defs/container"
        },
        "metadata_host_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "required": [
        "resource_id",
        "id",
        "roles",
        "management",
        "data",
        "run_root",
        "disks",
        "rdma",
        "services"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "roles": {
                "contains": {
                  "const": "volume"
                }
              }
            }
          },
          "then": {
            "properties": {
              "disks": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^(?:|/dev/disk/by-id/[A-Za-z0-9_./-]+)$"
        },
        "mount": {
          "type": "string",
          "pattern": "^/(?:[A-Za-z0-9_./-]+)?$"
        },
        "format_allowed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "device_id",
        "mount",
        "format_allowed"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mount": {
                "const": "/"
              }
            }
          },
          "then": {
            "properties": {
              "format_allowed": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "rdma_na": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "not_applicable"
        },
        "device": {
          "const": ""
        },
        "port": {
          "const": 0
        },
        "gid_index": {
          "type": "null"
        },
        "gid": {
          "const": ""
        },
        "link_layer": {
          "const": ""
        },
        "active_mtu": {
          "const": 0
        },
        "capabilities": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0,
              "maxItems": 0
            }
          ]
        },
        "fabric_evidence_sha256": {
          "const": ""
        }
      },
      "required": [
        "status"
      ]
    },
    "rdma_requested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "requested"
        },
        "device": {
          "type": "string",
          "pattern": "^(?:|[A-Za-z0-9_.:-]{1,64})$"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "gid_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "gid": {
          "type": "string",
          "pattern": "^(?:|[0-9a-f]{32})$"
        },
        "link_layer": {
          "type": "string",
          "enum": [
            "",
            "ethernet",
            "infiniband"
          ]
        },
        "active_mtu": {
          "type": "integer",
          "enum": [
            0,
            256,
            512,
            1024,
            2048,
            4096
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rc",
              "dc"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "fabric_evidence_sha256": {
          "const": ""
        }
      },
      "required": [
        "status",
        "capabilities"
      ]
    },
    "rdma_observed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "observed"
        },
        "device": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "gid_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "gid": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "not": {
            "const": "00000000000000000000000000000000"
          }
        },
        "link_layer": {
          "type": "string",
          "enum": [
            "ethernet",
            "infiniband"
          ]
        },
        "active_mtu": {
          "type": "integer",
          "enum": [
            256,
            512,
            1024,
            2048,
            4096
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rc",
              "dc"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "fabric_evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "status",
        "device",
        "port",
        "gid_index",
        "gid",
        "link_layer",
        "active_mtu",
        "capabilities",
        "fabric_evidence_sha256"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "boot_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "captured_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "host_id",
              "boot_id",
              "captured_at",
              "evidence_sha256"
            ]
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "requested_sha256",
        "hosts"
      ]
    },
    "deadlines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "hard",
        "cleanup_reserve_ms"
      ],
      "properties": {
        "work": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "hard": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "cleanup_reserve_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "docker_parent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "management": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "ipv4"
                },
                {
                  "type": "string",
                  "format": "ipv6"
                },
                {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$"
                }
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "user": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
            },
            "credential_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
            },
            "host_key": {
              "type": "string",
              "pattern": "^(?:|[A-Za-z0-9@._+-]+ [A-Za-z0-9+/]+={0,2})$",
              "minLength": 1
            }
          },
          "required": [
            "address",
            "port",
            "user",
            "credential_ref",
            "host_key"
          ]
        },
        "run_root": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_./-]+$"
        },
        "executor_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "executor_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^(?:|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
        },
        "root_device": {
          "type": "string",
          "pattern": "^(?:|0|[1-9][0-9]{0,19})$"
        },
        "root_inode": {
          "type": "string",
          "pattern": "^(?:|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "id",
        "management",
        "run_root",
        "executor_ref",
        "executor_sha256",
        "boot_id",
        "root_device",
        "root_inode"
      ]
    },
    "container_mount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disk_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_./-]+$"
        },
        "source_device": {
          "type": "string",
          "pattern": "^(?:|0|[1-9][0-9]{0,19})$"
        },
        "source_inode": {
          "type": "string",
          "pattern": "^(?:|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "disk_id",
        "source_path",
        "source_device",
        "source_inode"
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,128}$"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "pattern": "^(?:|[0-9a-f]{64})$"
        },
        "netns_inode": {
          "type": "string",
          "pattern": "^(?:|[1-9][0-9]{0,19})$"
        },
        "privileged": {
          "const": false
        },
        "mounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/container_mount"
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "parent_id",
        "name",
        "image_digest",
        "id",
        "netns_inode",
        "privileged",
        "mounts"
      ]
    },
    "docker_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent": {
          "$ref": "#/$defs/docker_parent"
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,67}$"
            },
            "id": {
              "type": "string",
              "pattern": "^(?:|[0-9a-f]{64})$"
            }
          },
          "required": [
            "name",
            "id"
          ]
        },
        "rdma_mode": {
          "enum": [
            "none",
            "rxe"
          ]
        },
        "unavailable_transports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "transport": {
                "const": "dc"
              },
              "status": {
                "const": "not_applicable"
              },
              "reason": {
                "enum": [
                  "software_profile_no_dc",
                  "rxe_no_dc"
                ]
              }
            },
            "required": [
              "transport",
              "status",
              "reason"
            ]
          }
        },
        "metadata_host_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "metadata_store": {
          "const": "mysql"
        }
      },
      "required": [
        "parent",
        "network",
        "rdma_mode",
        "unavailable_transports",
        "metadata_host_id",
        "metadata_store"
      ]
    }
  }
}
